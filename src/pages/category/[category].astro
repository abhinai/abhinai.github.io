---
import Base from '../../layouts/Base.astro';
import StoryGrid from '../../components/StoryGrid.astro';
import { getPosts, PHOTO_CATEGORY, slugify, type Post } from '../../lib/posts';
import categoryList from '../../data/categories.json';

export async function getStaticPaths() {
  const posts = await getPosts();
  // Every listed category gets a page (even before it has posts); Photos is served by /photos/ instead
  const categories = [...new Set([...categoryList.map((c) => c.name), ...posts.map((p) => p.data.category)])].filter(
    (c) => c !== PHOTO_CATEGORY,
  );
  return categories.map((name) => ({
    params: { category: slugify(name) },
    props: { name, posts: posts.filter((p) => p.data.category === name) },
  }));
}

interface Props {
  name: string;
  posts: Post[];
}

const { name, posts } = Astro.props;
---

<Base title={name} description={`Posts filed under ${name}.`}>
  <div class="page-head">
    <span class="label">Category</span>
    <h1>{name}</h1>
    <p>{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
  </div>
  <StoryGrid posts={posts} label="date" />
</Base>
