---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { byWeight, formatDate, getPhotos, photoAlt, postUrl } from '../lib/posts';

const photos = byWeight(await getPhotos());
const page = (await getEntry('pages', 'photos'))!;
---

<Base title={page.data.title} description={page.data.description}>
  <div class="page-head">
    <span class="label">Gallery</span>
    <h1>{page.data.title}</h1>
    <p>{page.data.description}</p>
  </div>

  <div class="photos">
    {
      photos.map((post) => (
        <a href={postUrl(post)}>
          <figure>
            <img src={post.data.thumb ?? post.data.cover} alt={photoAlt(post)} width="960" height="720" loading="lazy" />
            <figcaption>
              <span class="title">{post.data.title}</span>
              <span class="meta faint">{formatDate(post.data.day)}</span>
            </figcaption>
          </figure>
        </a>
      ))
    }
  </div>
</Base>
