---
import '../styles/global.css';
import { AUTHOR, SITE_DESCRIPTION, SITE_NAME } from '../lib/site';
import { categoryUrl, PHOTO_CATEGORY } from '../lib/posts';
import categories from '../data/categories.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Describes the share image */
  imageAlt?: string;
}

const { title, description = SITE_DESCRIPTION, image, imageAlt } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} · Ideas, technology, life`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isHome = path === '/';

const nav = [
  { href: '/', label: 'Home' },
  // Categories marked "nav" in src/data/categories.json, in that order
  ...categories.filter((c) => c.nav && c.name !== PHOTO_CATEGORY).map((c) => ({ href: categoryUrl(c.name), label: c.name })),
  { href: '/about/', label: 'About' },
  { href: '/links/', label: 'Links' },
  { href: '/photos/', label: 'Photos' },
];
const isCurrent = (href: string) => path === href || path === href.slice(0, -1);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    {image && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="sheet">
      <header class="masthead">
        {/* The home page has no other heading, so the name is its <h1> there */}
        {isHome ? (
          <h1 class="site-title"><a class="name" href="/">{SITE_NAME}</a></h1>
        ) : (
          <a class="name" href="/">{SITE_NAME}</a>
        )}
        <p class="tagline">Ideas · Technology · Life</p>
        <nav aria-label="Main">
          {nav.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="site-footer">
        <span>© {new Date().getFullYear()} {AUTHOR}</span>
        <nav aria-label="Footer">
          <a href="/rss.xml">RSS</a>
          <a href="https://linkedin.com/in/abhinai">LinkedIn</a>
          <a href="https://x.com/abhinai">X</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
